// #define num2 0x00FF00// green
// #define nav3 0x00FFEA// blue

#define onG 0x00FF00// green
#define sec4 0xFFFFFF// white
#define qwe5 0x0051FF// dark blue

#define red 0xff0000//red
#define grn 0x00FF00// green
#define ylw 0xFBFF00// yellow
#define blu 0x00FFEA// blue
#define blk 0x000000// black

// * Orange theming
#define def0 0xFF5E00// main oraage
#define sym1 0xD900FF// purple
#define num2 0x00FFEA// blue
#define nav3 0xFFC800// yellow

